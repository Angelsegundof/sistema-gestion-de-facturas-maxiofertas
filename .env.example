# ==============================================================================
# SISTEMA DE GESTIÓN DE FACTURAS MAXIOFERTAS - ENVIRONMENT CONFIGURATION
# ==============================================================================
# IMPORTANTE: Nunca coloques secretos reales en este archivo ni versionar .env
# Copia este archivo a .env.local para desarrollo local.

# ------------------------------------------------------------------------------
# APLICACIÓN
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# BASE DE DATOS (Neon PostgreSQL)
# ------------------------------------------------------------------------------
# Formato: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password_here@ep-example-123456.us-east-2.aws.neon.tech/maxiofertas_facturas?sslmode=require

# ------------------------------------------------------------------------------
# AUTENTICACIÓN (Fase posterior - No activo en Fase 1)
# ------------------------------------------------------------------------------
# Secreto para firma criptográfica de sesiones/tokens (mínimo 32 caracteres)
AUTH_SECRET=your_auth_secret_minimum_32_characters_here
# Credenciales OAuth Google exclusivas del Sistema de Facturas
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ------------------------------------------------------------------------------
# ALMACENAMIENTO DOCUMENTAL (Cloudflare R2)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET=maxiofertas-facturas-dev

# ------------------------------------------------------------------------------
# PARÁMETROS OPERACIONALES Y DE DOMINIO
# ------------------------------------------------------------------------------
# Tamaño máximo de archivos PDF (en bytes, default: 5MB = 5242880)
MAX_FILE_SIZE_BYTES=5242880
# Tolerancia de cuadratura en pesos chilenos (CLP)
ROUNDING_TOLERANCE_CLP=2
# Ventana para alerta informativa de posible duplicado (en horas)
DUPLICATE_WINDOW_HOURS=24
